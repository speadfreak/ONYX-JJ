# ═══════════════════════════════════════════════════════════════════════
# JJ ONYX — environment variable reference
# Copy to .env (local) or paste into Render → Environment (production).
# NEVER commit the real .env — it is gitignored.
# ═══════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────
# Local / SQLite-on-persistent-disk:
#   file:./db/custom.db   (path relative to the prisma/ folder resolves to /db)
# Render + managed Postgres (recommended for production):
#   the "Internal Database URL" Render shows on the Postgres instance page,
#   e.g. postgresql://user:pass@host:5432/onyx?sslmode=require
DATABASE_URL="file:./db/custom.db"

# ── Admin session signing (JWT, httpOnly cookie) ────────────────────────
# MUST be ≥ 32 chars. Generate a FRESH one for production — never reuse a
# sandbox/dev value that may have appeared anywhere else:
#   openssl rand -base64 48
ADMIN_SESSION_SECRET="generate-a-fresh-64-char-random-string-for-production"

# ── Owner bootstrap (used ONLY when the AdminUser table is empty) ───────
# First boot creates the role="owner" account from these. They are NOT
# needed again afterwards (change email/password in /admin/account).
# Set a NEW production password — do NOT reuse any sandbox credential.
ADMIN_EMAIL="jj@yourdomain.com"
ADMIN_PASSWORD="a-long-new-production-password"
# (alternative to ADMIN_PASSWORD: a pre-computed bcrypt hash)
# ADMIN_PASSWORD_HASH="$2b$10$..."

# ── Server bind address (REQUIRED on Render / any Kubernetes host) ──────
# Render runs containers on Kubernetes, which injects HOSTNAME=<pod-name>
# into every container. Next.js standalone server.js uses that value as the
# bind address, binding to an interface Render's router cannot reach → the
# service 502s forever despite a clean boot. Force 0.0.0.0 (all interfaces):
HOSTNAME="0.0.0.0"

# ── Cookies ─────────────────────────────────────────────────────────────
# Leave unset in production (secure cookies over HTTPS).
# Set to 1 ONLY for plain-HTTP sandbox/preview environments.
# INSECURE_COOKIES=1

# ── Optional / future ───────────────────────────────────────────────────
# Ask JJ currently runs on the built-in AI SDK. If you swap it to Groq
# (see src/app/api/ask-jj/route.ts TODO), add its key here:
# GROQ_API_KEY=""
# Market Pulse uses free public endpoints (Binance + Frankfurter) — no key
# needed. If you later add a real XAU/USD metals feed, put its key here:
# METALS_API_KEY=""
